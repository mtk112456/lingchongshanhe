# 复制为 deploy/lingchong/.env 后填写；.env 已被 git 忽略，绝不提交。
#   cp deploy/lingchong/.env.example deploy/lingchong/.env
#   chmod 600 deploy/lingchong/.env
# 所有值都是占位符，上线前必须替换成随机强密码/真实 token。

# ---- 数据库（compose 首次初始化卷时生效；改密码需同步改库内用户） ----
DB_NAME=class_manager
DB_USER=lingchong_api
DB_PASS=replace_with_a_long_random_password
# root 只用于容器内运维，不用于应用连接。
DB_ROOT_PASS=replace_with_another_long_random_password

# ---- Cloudflare Tunnel ----
# Zero Trust -> Networks -> Tunnels -> 目标 Tunnel -> Install connector 取得 token。
# token 等同凭据，泄露后立即在面板轮换。
TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# ---- API ----
# 只绑定回环，供本机 curl 自检；公网入口只走 cloudflared。
API_BIND=127.0.0.1
API_PORT=8080
TZ=Asia/Shanghai
TURN_SECONDS=600
# 试跑期可临时设 1 允许教师提前锁令；正式上线保持 0。
ALLOW_FORCE_LOCK=0

# ---- 镜像版本 ----
# 发布时改成日期或 git 短哈希，便于回滚；不填则用 local。
API_TAG=local
# 生产建议固定 cloudflared 版本，避免 latest 漂移。
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
